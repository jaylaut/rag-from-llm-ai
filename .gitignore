# 环境变量（含密钥，勿提交到 git）
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.workbuddy/

# 数据目录（原始数据、向量索引等体积大，不入库）
raw/
raw.zip
data/
!data/raw/.gitkeep
!data/index/.gitkeep
!data/chunks/.gitkeep
!data/documents/.gitkeep

# 日志
data/logs/*

# 测试与工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 运行期产生的临时状态文件（断点续传进度、死信清单等）
data/index/job.json
data/index/dead_letter.json

# IDE
.idea/
.vscode/

# 系统
.DS_Store
Thumbs.db

# 下载临时文件
*.downloading
*.crdownload
*.part
