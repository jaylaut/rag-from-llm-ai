# ============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# ---- QWEN-MAX 远程大模型 API ----
# 阿里云百炼 / DashScope 平台申请的 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# QWEN-MAX 模型名（可切换为 qwen-plus / qwen-turbo 等）
QWEN_MODEL=qwen-max

# ---- 本地 Ollama 嵌入模型 ----
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# ---- 本地重排模型（cross-encoder，P2 检索后精排用）----
# 注意：Qwen3-Reranker 官方 tag 不存在，用社区/官方 GGUF
# 0.6B 体积小、与嵌入模型共用 4GB 显存；质量要求更高可换 4B
# 🚨 部署方式：llama.cpp（llama-server）。Ollama 不支持重排模型；
#    vLLM 要求 GPU 算力 7.0+（Volta 起）且不原生支持 Windows，本机 Pascal 显卡不可行。
#    启动：llama-server -hf ggml-org/Qwen3-reranker-0.6B-Q8_0-GGUF:Q8_0 \
#          --embedding --rerank --pooling rank --port 9931
RERANK_MODEL=ggml-org/Qwen3-reranker-0.6B-Q8_0-GGUF

# ---- 通用 ----
LOG_LEVEL=INFO
